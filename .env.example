# ─── Database ────────────────────────────────────────────────────────────────
# Local SQLite file. For a shared deployment, switch the provider in
# prisma/schema.prisma to "postgresql" and point this at your server.
DATABASE_URL="file:./dev.db"

# ─── Access ──────────────────────────────────────────────────────────────────
# Shared password for the whole app. LEAVE THIS SET IN ANY DEPLOYED
# ENVIRONMENT — the database holds voter names, addresses and phone numbers.
# If unset, the app runs unauthenticated (fine for a laptop, not for a server).
APP_PASSWORD=""

# The app's public URL. Needed so Twilio's webhooks can be verified against the
# address they were actually sent to, e.g. https://campaign.example.com
APP_URL=""

# ─── Maps ────────────────────────────────────────────────────────────────────
# Google Geocoding API key, used only to turn addresses into coordinates.
# Not needed at all if your address file already has latitude and longitude —
# see "Loading addresses" in the README. Map tiles come from OpenStreetMap and
# need no key.
GOOGLE_GEOCODING_API_KEY=""

# ─── Text messaging ──────────────────────────────────────────────────────────
# Leave blank to run the whole texting pipeline in dry-run mode: audiences,
# costs and message rendering all work, but nothing is sent.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Either a messaging service (preferred — handles number pooling and opt-outs)
# or a single from-number.
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_FROM_NUMBER=""
# Cost per message segment in cents, for the send estimate only.
SMS_PER_SEGMENT_CENTS="1"
