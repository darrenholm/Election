# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL. On Railway, add a Postgres service and reference its variable
# rather than pasting the string: DATABASE_URL=${{Postgres.DATABASE_URL}}
# For local development, use the public connection string from that same
# Railway Postgres service.
DATABASE_URL="postgresql://user:password@host:5432/campaign"

# ─── Access ──────────────────────────────────────────────────────────────────
# Signs the session cookie. REQUIRED IN ANY DEPLOYED ENVIRONMENT: the app
# refuses to serve in production without it, because the development fallback
# is published in this repository and anyone could forge a session with it.
# At least 16 characters; something like `openssl rand -hex 32`.
# Rotating it signs everybody out, which is the lever to pull if a laptop with
# a live session goes missing.
SESSION_SECRET=""

# Accounts are per person now — each candidate signs in with their own email and
# password, set up under Team — so there is no shared app password any more.
# This is kept only so installs made before accounts existed keep working: it is
# used as the cookie signing key when SESSION_SECRET is unset. On a new install,
# set SESSION_SECRET and leave this blank.
APP_PASSWORD=""

# The app's public URL, e.g. https://campaign.up.railway.app
# Needed so Twilio's webhooks can be verified against the address they were
# actually sent to.
APP_URL=""

# ─── Reading the canvass back ─────────────────────────────────────────────────
# Turns the free-text notes written at doors into the themes that recur. Leave
# blank and the page still works, and says plainly that nothing can be read.
#
# Billed separately from any Claude subscription: create a key at
# platform.claude.com/settings/keys. Usage is small — a few hundred short notes
# per reading.
#
# Names, addresses, phone numbers and email addresses are never sent. What goes
# out is the note text, the street it was written on, and the support level at
# the time. Tell your candidates that, because their canvassers wrote those
# notes about named residents.
ANTHROPIC_API_KEY=""
# Optional. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=""
# ─── Maps ────────────────────────────────────────────────────────────────────
# Google Geocoding API key, used only to turn addresses into coordinates.
# Not needed at all if your address file already has latitude and longitude —
# Statistics Canada's Open Database of Addresses does. Map tiles come from
# OpenStreetMap and need no key.
GOOGLE_GEOCODING_API_KEY=""

# ─── Text messaging ──────────────────────────────────────────────────────────
# One Twilio account serves every campaign; each candidate's own sending number
# is set per campaign in Settings, because consent runs to a named sender.
# Leave these blank to run the whole texting pipeline in dry-run mode.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Fallback sender, used only by campaigns with no number of their own.
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_FROM_NUMBER=""
# Cost per message segment in cents, for the send estimate only.
SMS_PER_SEGMENT_CENTS="1"

# ─── Facebook ────────────────────────────────────────────────────────────────
# One Meta developer app serves every campaign; each candidate connects their
# own Page from the Facebook section, because a post goes out in their name.
# Leave these blank to run the whole posting pipeline in dry-run mode: the
# plan, the drafts and the schedule all work, and publishing records what would
# have gone out.
# pages_manage_posts needs no App Review to post to a Page you administer —
# admins, developers and testers of the app can grant it and post immediately.
# Review is only needed so that people with no role on the app can connect
# their own Pages.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Pin the Graph version if you need to; defaults to a recent one.
FACEBOOK_GRAPH_VERSION=""

# ─── Election print portal ───────────────────────────────────────────────────
# The candidate-facing shopfront at /election, where signs, post cards, door
# hangers, shirts, hoodies and decals are ordered. It runs with none of these
# set — the shop name and the e-transfer address below are the defaults.
#
# Payment is by Interac e-transfer, so this address is the whole payment
# system: it is printed on the confirmation page and on every order, and
# somebody at the shop marks the money in when it lands.
SHOP_NAME="Holm Graphics"
SHOP_ETRANSFER_EMAIL="darren@holmgraphics.ca"
# Both optional. Left blank, the portal simply does not show them.
SHOP_PHONE=""
SHOP_PICKUP_ADDRESS=""

# ─── SinaLite (trade printing) ───────────────────────────────────────────────
# Post cards and door hangers are bought in from SinaLite and drop-shipped;
# signs are cut from sheets in the shop and never go near this.
#
# Leave the credentials blank to run the whole thing as a dry run: quotes come
# back marked, "sending" an order records what would have gone, and the queue
# says so on the page.
#
# Sandbox is api.sinaliteuppy.com; set SINALITE_ENV=live for liveapi.sinalite.com.
SINALITE_CLIENT_ID=""
SINALITE_CLIENT_SECRET=""
SINALITE_ENV="sandbox"
# The OAuth audience is a fixed value in their documentation, the same for the
# sandbox and the live API. Only set this if they change it.
SINALITE_AUDIENCE="https://apiconnect.sinalite.com"
# Their store id — a number. 6 is Canada, 9 is the United States.
SINALITE_STORE_CODE="6"
# Percent added to their trade cost to reach retail. 100 doubles it. Our own
# file-prep charge is added on top, from the catalogue's setup fee.
SINALITE_MARKUP_PERCENT="100"

# Where the trade printer ships a PICKUP order — the shop itself. A delivered
# order goes straight to the candidate instead. Without these, sending a pickup
# order to SinaLite is refused rather than guessed at.
SHOP_SHIP_NAME=""
SHOP_SHIP_ADDRESS=""
SHOP_SHIP_ADDRESS_2=""
SHOP_SHIP_CITY=""
SHOP_SHIP_PROVINCE="ON"
SHOP_SHIP_POSTAL_CODE=""
SHOP_SHIP_COUNTRY="CA"
SHOP_SHIP_PHONE=""

# Who pays the trade printer — always the shop, never the candidate, who is
# buying from Holm Graphics and must never see a trade price. Falls back to the
# shipping details above.
SHOP_BILLING_NAME=""
SHOP_BILLING_EMAIL=""

# ─── SanMar (garments) ───────────────────────────────────────────────────────
# Colours, sizes and dealer costs for the styles the shop prints on. SanMar's
# services are SOAP and implement the PromoStandards suite, which is what makes
# them writable without having watched a call go over: the envelopes are the
# standard's. What is uncertain is which endpoints this account uses, so run
#   railway run npm run sanmar:probe
# and put whatever answers into SANMAR_PRODUCT_URL / SANMAR_PRICING_URL. Then
#   railway run npm run sanmar:sync
# A CSV export off the dealer portal works too, and needs no endpoints at all:
#   npm run garments:import -- export.csv --dry-run
#
# The web-services credentials are not the portal sign-in.
SANMAR_CUSTOMER_NUMBER=""
SANMAR_USERNAME=""
SANMAR_PASSWORD=""
# Their media service uses a password of its own. Not used yet — it is where
# product photography would come from.
SANMAR_MEDIA_PASSWORD=""
SANMAR_ENV="sandbox"
# Put the endpoints here once npm run sanmar:probe says which ones answer, so
# nothing has to guess again. SanMar Canada's differ from SanMar US.
SANMAR_PRODUCT_URL=""
SANMAR_PRICING_URL=""
SANMAR_CURRENCY="CAD"

# The domain the election portal is served on. Set it and that domain's root
# redirects to /election, so candidates can be given election.holmgraphics.ca
# rather than election.holmgraphics.ca/election. Leave blank and nothing
# changes — the portal is still at /election on every domain.
PORTAL_HOST=""

# Where the shop lives, if the campaign manager is on a different domain. The
# "Order more signs" link in the campaign manager is built from it, and carries
# a signed handoff so the storefront fills the candidate's details in. Leave
# blank when both halves share a domain — APP_URL is used instead.
PORTAL_URL=""
